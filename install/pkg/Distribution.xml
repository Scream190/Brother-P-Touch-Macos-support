<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Brother PT-P710BT Driver</title>
    <organization>com.github.brother-ptp710bt-driver</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.github.brother-ptp710bt-driver"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.github.brother-ptp710bt-driver" visible="false">
        <pkg-ref id="com.github.brother-ptp710bt-driver"/>
    </choice>
    <pkg-ref id="com.github.brother-ptp710bt-driver" version="0" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
