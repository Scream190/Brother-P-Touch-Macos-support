#!/usr/bin/env python3
"""CUPS filter: CUPS Raster -> Brother PT-P710BT raster-mode command stream.

Called by cupsd per the standard CUPS filter argv convention:

    rastertoptp710bt job-id user title copies options [filename]

Reads a CUPS Raster (application/vnd.cups-raster) job from ``filename`` or
stdin, and writes the printer-ready Brother command bytes to stdout, where
the ``ptp710bt`` backend (see ../backend/ptp710bt) picks them up and streams
them to the printer over its paired Bluetooth serial connection.

This filter sits at the END of the filter chain: the PPD's cupsFilter2 line
tells CUPS to first turn the incoming job (PDF/PostScript/etc.) into CUPS
Raster using CUPS's own bundled filters, and only then hand it to us. That
keeps this file focused solely on the printer-specific raster-mode framing.
"""
import os
import sys

# install.sh vendors a copy of the brother_ptraster package directly next
# to this script (see install/install.sh) rather than under /usr/local:
# cupsd runs filters under a restricted filesystem sandbox on modern macOS
# that does not appear to allow reading /usr/local, even as root -- real
# hardware test showed "ModuleNotFoundError: No module named
# 'brother_ptraster'" despite the directory demonstrably existing there
# with correct permissions. /usr/libexec/cups/filter is provably readable
# (cupsd is already executing this very script from inside it), so that's
# where the package needs to live for the installed case. Falls back to
# the repo layout (../) so this also works uninstalled, straight out of a
# git checkout.
_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
if os.path.isdir(os.path.join(_THIS_DIR, "brother_ptraster")):
    sys.path.insert(0, _THIS_DIR)
else:
    sys.path.insert(0, os.path.join(_THIS_DIR, ".."))

from brother_ptraster.cups_raster import read_pages, RasterFormatError
from brother_ptraster.media import DPI, nearest_media
from brother_ptraster.orient import transform_page
from brother_ptraster.protocol import RasterJobBuilder

# PPD *ImageRotate choice names -> degrees clockwise.
ROTATE_CHOICES = {"None": 0, "Rotate90": 90, "Rotate180": 180, "Rotate270": 270}


def log(level: str, message: str) -> None:
    sys.stderr.write(f"{level}: [rastertoptp710bt] {message}\n")
    sys.stderr.flush()


def parse_options(options_str: str) -> dict:
    """Parse CUPS's space-separated ``key=value`` option string.

    CUPS quotes values containing spaces with single quotes, e.g.
    ``media=mm12 title='My Label'``.
    """
    opts = {}
    token = ""
    in_quotes = False
    tokens = []
    for ch in options_str:
        if ch == "'" :
            in_quotes = not in_quotes
            token += ch
        elif ch == " " and not in_quotes:
            if token:
                tokens.append(token)
            token = ""
        else:
            token += ch
    if token:
        tokens.append(token)

    for tok in tokens:
        if "=" in tok:
            key, _, value = tok.partition("=")
            opts[key] = value.strip("'")
        else:
            opts[tok] = "True"
    return opts


def main() -> int:
    if len(sys.argv) not in (6, 7):
        log("ERROR", f"usage: {sys.argv[0]} job-id user title copies options [file]")
        return 1

    _job_id, _user, _title, copies_str, options_str = sys.argv[1:6]
    infile = sys.argv[6] if len(sys.argv) == 7 else None

    try:
        copies = max(1, int(copies_str))
    except ValueError:
        copies = 1

    opts = parse_options(options_str)
    auto_cut = opts.get("AutoCut", "True") != "False"
    rotate = ROTATE_CHOICES.get(opts.get("ImageRotate", "None"), 0)
    mirror = opts.get("ImageMirror", "False") == "True"

    log("INFO", f"auto_cut={auto_cut} rotate={rotate} mirror={mirror} copies={copies}")

    src = open(infile, "rb") if infile else sys.stdin.buffer
    out = sys.stdout.buffer

    try:
        pages = list(read_pages(src))
    except RasterFormatError as exc:
        log("ERROR", f"failed to parse CUPS raster input: {exc}")
        return 1
    finally:
        if infile:
            src.close()

    if not pages:
        log("ERROR", "input contained no pages")
        return 1

    for copy in range(copies):
        for page_num, page in enumerate(pages, start=1):
            # Use the resolution the rasterizer actually used, not an
            # assumed constant: real hardware test found cgpdftoraster
            # used 100dpi despite the PPD declaring 180dpi as the only
            # resolution (a missing *OpenUI/*CloseUI wrapper around
            # *Resolution meant CUPS wasn't recognizing it as a real
            # option). We only know how to send raster data dot-for-dot to
            # the printer's fixed 180dpi head, so if the actual resolution
            # doesn't match, the safe thing is to refuse rather than print
            # at the wrong physical size.
            dpi_x, dpi_y = page.hw_resolution
            if dpi_x != DPI or dpi_y != DPI:
                log(
                    "ERROR",
                    f"page {page_num}: job was rasterized at {dpi_x}x{dpi_y}dpi, "
                    f"but this driver only supports {DPI}dpi (the printer's native "
                    f"resolution) -- check the PPD's Resolution option/CUPS config",
                )
                return 1

            # Mandatory structural transpose: the PPD declares pages WIDE
            # (Width = label length, Height = tape width) so cgpdftoraster
            # renders normal horizontal text instead of auto-rotating for
            # vertical reading (see the PPD's comment on *PageSize for why).
            # But that means CUPS hands us rows that run along the LENGTH
            # axis (page.width, potentially thousands of dots) with only
            # page.height (tens of dots) of them -- the opposite of what
            # the printer needs (many lines, each spanning the tape width).
            # Transposing unconditionally fixes that; it is not a user
            # preference, just how this page geometry has to be unpacked.
            rows, width = transform_page(page.rows, page.width, rotate=90, mirror=False)

            # User-selectable rotate/mirror (see PPD *ImageRotate/
            # *ImageMirror) apply ON TOP of the mandatory transpose above,
            # e.g. to flip back to vertical-reading orientation or correct
            # a mirrored/upside-down result if the transpose direction
            # guessed above turns out to be the wrong one of the two valid
            # options for a given print.
            if rotate or mirror:
                rows, width = transform_page(rows, width, rotate=rotate, mirror=mirror)

            width_mm = width / dpi_x * 25.4
            try:
                media = nearest_media(width_mm)
            except ValueError as exc:
                log("ERROR", f"page {page_num}: {exc}")
                return 1

            builder = RasterJobBuilder(media, auto_cut=auto_cut)
            for row in rows:
                if len(row) >= media.print_bytes:
                    line = row[: media.print_bytes]
                else:
                    line = row + b"\x00" * (media.print_bytes - len(row))
                builder.add_line(line)
            out.write(builder.build())
            log(
                "DEBUG",
                f"copy {copy + 1}/{copies} page {page_num}/{len(pages)}: "
                f"media={media.name} {len(rows)} lines",
            )

    out.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
